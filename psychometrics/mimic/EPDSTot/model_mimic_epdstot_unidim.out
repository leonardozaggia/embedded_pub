    COG  ON EPDSTot;

  OUTPUT:
    STANDARDIZED;
    MODINDICES(10);
    RESIDUAL;
    SAMPSTAT;
    TECH1;
    TECH4;
    CINTERVAL;

  SAVEDATA:
    FILE = "../../fscores_mimic.dat";
    SAVE = FSCORES;



