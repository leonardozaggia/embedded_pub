TITLE:
  MIMIC model - AntCor as predictor of cognitive latent factors (CONSTRAINED-A)
  Constraint A: WM = GDP for AntCor_P only
    (WM=+0.228 ns, GDP=-0.432 ns; opposite signs; largest STDY diff = 0.660)
    AntCor_C paths are freely estimated.
  Factors: WM, GDP, FS (same measurement model as model_measurement.inp)

DATA:
  FILE = "../../combined.dat";

VARIABLE:
  NAMES ARE
    COG034 COG035 COG036 COG037 COG038 COG039 COG040 COG041
    COG042 COG043 COG044 COG045 COG046 COG047 COG048 COG049 COG050
    COG051 COG052 COG053 COG054 COG055 COG056 COG057 COG058
    COG060 COG061 COG062 COG063 COG064 COG065 COG066 COG067 COG068
    GA BirthWt Sex HdCirc IUGR GDiab PrEcl AntCor_P AntCor_C
    MomAge MomEdu DadEdu EthSAsian EthBlack EthMixed EthOther
    MomEng EPDSTot StimEnv PrLax PrOvr PrVrb PrSty
    CBInt CBExt CBTot CBAnx CBWth CBSom CBSlp CBAtt CBAgg
    ECSur ECNeg ECEff BayMot BayLan QchatTot CBEmR;

  USEVARIABLES ARE
    COG040 COG041
    COG043 COG044 COG045 COG046 COG048 COG049 COG050
    COG051 COG052 COG053 COG054 COG055 COG056 COG057 COG058
    COG060 COG061 COG062 COG063 COG064 COG066
    AntCor_P AntCor_C;

  CATEGORICAL ARE
    COG040 COG041
    COG043 COG044 COG045 COG046 COG048 COG049 COG050
    COG051 COG052 COG053 COG054 COG055 COG056 COG057 COG058
    COG060 COG061 COG062 COG063 COG064 COG066;

  MISSING ARE ALL (-999);

ANALYSIS:
  ESTIMATOR = WLSMV;
  DIFFTEST = "difftest_free.dat";


MODEL:
  ! Factor 1: Working Memory (6 items)
  WM BY
    COG040 COG045 COG050 COG064;

  ! Factor 2: Goal-Directed Problem Solving (13 items)
  GDP BY
    COG041 COG043 COG044 COG046
    COG048 COG052 COG053 COG057;

  ! Factor 3: Flexibility / Shift (15 items)
  FS BY
    COG049 COG051 COG054 COG055 COG056
    COG058 COG060 COG061 COG062 COG063 COG066;

  ! AntCor_P: WM = GDP (label ac_p); AntCor_C: all free
  ! Separate ON statements so label applies only to AntCor_P
  WM  ON AntCor_P(ac_p);
  GDP ON AntCor_P(ac_p);
  FS  ON AntCor_P;
  WM  ON AntCor_C;
  GDP ON AntCor_C;
  FS  ON AntCor_C;

  WM  WITH GDP FS;
  GDP WITH FS;

OUTPUT:
  STANDARDIZED;
  MODINDICES(10);
  RESIDUAL;
  SAMPSTAT;
  TECH1;
  TECH4;
  CINTERVAL;
