    ! and inter-factor residual covariances are freely estimated.
    COG  ON GA;

  OUTPUT:
    STANDARDIZED;
    MODINDICES(10);
    RESIDUAL;
    SAMPSTAT;
    TECH1;
    TECH4;
    CINTERVAL;

  SAVEDATA:
    FILE = "../fscores_mimic.dat";
    SAVE = FSCORES;



