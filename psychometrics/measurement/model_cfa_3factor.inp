TITLE:
  Confirmatory CFA with categorical indicators - Measurement model only
  3 factors: WM (Working Memory), GDP (Goal-Directed Problem Solving),
  FS (Flexibility/Shift)
  34 dichotomous items; factor spec from b3_model_spec.yaml mixed_centroids
  (COG059 excluded: sparse attention factor)
  Factor spec: mixed_centroids, v6_cog (Aylward et al. 2022 expert-guided)

DATA:
  FILE = "combined.dat";

VARIABLE:
  NAMES ARE
    COG034 COG035 COG036 COG037 COG038 COG039 COG040 COG041
    COG042 COG043 COG044 COG045 COG046 COG047 COG048 COG049 COG050
    COG051 COG052 COG053 COG054 COG055 COG056 COG057 COG058
    COG060 COG061 COG062 COG063 COG064 COG065 COG066 COG067 COG068
    GA BirthWt Sex HdCirc IUGR GDiab PrEcl AntCor_P AntCor_C
    MomAge MomEdu DadEdu EthSAsian EthBlack EthMixed EthOther
    MomEng EPDSTot StimEnv PrLax PrOvr PrVrb PrSty
    CBInt CBExt CBTot CBAnx CBWth CBSom CBSlp CBAtt CBAgg
    ECSur ECNeg ECEff BayMot BayLan QchatTot CBEmR;

  USEVARIABLES ARE
    COG040 COG041
    COG043 COG044 COG045 COG046 COG048 COG049 COG050
    COG051 COG052 COG053 COG054 COG055 COG056 COG057 COG058
    COG060 COG061 COG062 COG063 COG064 COG066;

  CATEGORICAL ARE
    COG040 COG041
    COG043 COG044 COG045 COG046 COG048 COG049 COG050
    COG051 COG052 COG053 COG054 COG055 COG056 COG057 COG058
    COG060 COG061 COG062 COG063 COG064 COG066;

  MISSING ARE ALL (-999);

ANALYSIS:
  ESTIMATOR = WLSMV;


MODEL:
  ! Factor 1: Working Memory (4 items)
  WM BY
    COG040 COG045 COG050 COG064;

  ! Factor 2: Goal-Directed Problem Solving (8 items)
  GDP BY
    COG041 COG043 COG044 COG046
    COG048 COG052 COG053 COG057;

  ! Factor 3: Flexibility / Shift (11 items)
  FS BY
    COG049 COG051 COG054 COG055 COG056
    COG058 COG060 COG061 COG062 COG063 COG066;

  ! Factor correlations freely estimated (oblique solution)
  ! Explicit WITH statements ensure oblique solution is active regardless
  ! of Mplus version or PARAMETERIZATION defaults.
  WM WITH GDP FS;
  GDP WITH FS;

OUTPUT:
  STANDARDIZED;     ! Standardized loadings (equivalent to discrimination a)
  MODINDICES(10);   ! Modification indices above threshold of 10
  RESIDUAL;         ! Normalized residuals and residual correlations for local fit
  SAMPSTAT;         ! Sample statistics
  TECH1;            ! Parameter specifications
  TECH4;            ! Latent variable means, variances, covariances
  CINTERVAL;        ! 95% confidence intervals

SAVEDATA:
  FILE = "fscores_measurement.dat";
  SAVE = FSCORES;   ! EAP factor scores (descriptive use only)
